#!/bin/bash
# Claude Code hook for Konvoy. Appends one line per event to the pane's event file:
#   time  event  session_id  tool_name  notification_type  config_dir  background_tasks
# background_tasks is only set on Stop: the kinds of the tasks that still run, such as
# "shell,subagent". Outside a Konvoy pane, or when Konvoy is gone, it does
# nothing, and it leaves out events that say nothing about the pane's own chat (see
# below). It prints nothing, because SessionStart and UserPromptSubmit output would
# land in Claude's context.

file="${XDG_RUNTIME_DIR:-/run/user/$UID}/konvoy/events/${KONVOY_PANE:-none}"
if [ -z "$KONVOY_PANE" ] || [ ! -f "$file" ]; then
    cat >/dev/null
    exit 0
fi

# Most fields sit near the start of the JSON; tool input and output can be large.
# Stop lists its background tasks after the last message, so it is read in full.
input=
if [ "$1" = Stop ]; then
    input=$(cat)
    head=${input:0:4096}
else
    head=$(head -c 4096)
    cat >/dev/null
fi

# A claude started inside a pane, such as a claude -p that a chat runs, inherits
# KONVOY_PANE. Only the pane's own claude counts, so an event from a claude that has
# another one above it on the way up to Konvoy is left out. The walk stops at Konvoy,
# because Konvoy itself may have been started from a chat.
claudes=0
pid=$PPID
while [ "$pid" -gt 1 ] && read -r comm 2>/dev/null <"/proc/$pid/comm"; do
    [ "$comm" = konvoy ] && break
    [ "$comm" = claude ] && claudes=$((claudes + 1))
    read -r stat 2>/dev/null <"/proc/$pid/stat" || break
    stat=${stat##*) }
    stat=${stat#* }
    pid=${stat%% *}
done
if [ "$claudes" -gt 1 ]; then
    exit 0
fi

field() {
    local re="\"$1\": ?\"([^\"]*)\""
    [[ $head =~ $re ]] && printf '%s' "${BASH_REMATCH[1]}"
}

# Subagents and the hidden copies of the chat that Claude Code runs on its own, such
# as the one that suggests the next prompt after a turn, send an agent_id. Copies and
# background agents may not show dialogs: they run the question and permission hooks
# and are then refused, so nothing waits on screen. A dialog that does show, also a
# subagent's, fires Notification after about 6 seconds, which has no agent_id. Their
# API errors (StopFailure) do not end the chat's turn either.
case $1 in
PreToolUse | PermissionRequest | StopFailure)
    if [ -n "$(field agent_id)" ]; then
        exit 0
    fi
    ;;
esac

# A compact, by hand or automatic, starts the same session again in the same process.
# Its background tasks keep running and a turn may go on, so the pane keeps its state.
if [ "$1" = SessionStart ] && [ "$(field source)" = compact ]; then
    exit 0
fi

# Quotes inside JSON strings are escaped, so "type":"..." only matches real keys.
tasks=
if [[ $input == *'"background_tasks":['* ]]; then
    rest=${input#*'"background_tasks":['}
    rest=${rest%%'],"session_crons"'*}
    re='"type": ?"([^"]*)"'
    while [[ $rest =~ $re ]]; do
        tasks+=${tasks:+,}${BASH_REMATCH[1]}
        rest=${rest#*"${BASH_REMATCH[0]}"}
    done
fi

printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\n' "$EPOCHREALTIME" "$1" "$(field session_id)" "$(field tool_name)" \
    "$(field notification_type)" "${CLAUDE_CONFIG_DIR-}" "$tasks" >>"$file"
exit 0
