#!/usr/bin/env python3
"""Adds or removes Konvoy's entries in Claude Code settings files.

Usage: konvoy-hooks install|remove|status --hook PATH [--yes] SETTINGS_FILE...

Only entries whose command runs konvoy-hook are touched. Everything else in the
file, other hooks included, stays exactly as it is. Files that are symlinks to the
same settings file are handled once.
"""

import argparse
import copy
import json
import os
import re
import shlex
import sys
import tempfile

# (event, matcher). The hooks only record events, they never decide anything.
EVENTS = [
    ("SessionStart", None),
    ("UserPromptSubmit", None),
    ("PreToolUse", "AskUserQuestion|ExitPlanMode"),
    ("PermissionRequest", None),
    ("Notification", None),
    ("Stop", None),
    ("StopFailure", None),
    ("SessionEnd", None),
]

def command(hook, event):
    return f'[ -z "$KONVOY_PANE" ] || {shlex.quote(hook)} {event}'


def is_ours(entry):
    return re.search(r"/konvoy-hook'? [A-Za-z]+$", str(entry.get("command", ""))) is not None


def without_ours(settings):
    out = copy.deepcopy(settings)
    hooks = out.get("hooks")
    if not isinstance(hooks, dict):
        return out
    for event in list(hooks):
        groups = []
        for group in hooks[event]:
            kept = [h for h in group.get("hooks", []) if not is_ours(h)]
            if kept:
                groups.append({**group, "hooks": kept})
        if groups:
            hooks[event] = groups
        else:
            del hooks[event]
    if not hooks:
        del out["hooks"]
    return out


def with_ours(settings, hook):
    out = without_ours(settings)
    hooks = out.setdefault("hooks", {})
    for event, matcher in EVENTS:
        group = {"hooks": [{"type": "command", "command": command(hook, event), "timeout": 5}]}
        if matcher:
            group = {"matcher": matcher, **group}
        hooks.setdefault(event, []).append(group)
    return out


def ours(settings):
    found = []
    for event, groups in (settings.get("hooks") or {}).items():
        for group in groups:
            for h in group.get("hooks", []):
                if is_ours(h):
                    found.append(event)
    return found


def load(path):
    try:
        with open(path, encoding="utf-8") as f:
            return json.load(f)
    except FileNotFoundError:
        return {}


def save(path, settings):
    directory = os.path.dirname(path)
    mode = os.stat(path).st_mode & 0o777 if os.path.exists(path) else 0o600
    fd, tmp = tempfile.mkstemp(dir=directory, prefix=".settings.", suffix=".konvoy")
    with os.fdopen(fd, "w", encoding="utf-8") as f:
        json.dump(settings, f, indent=2, ensure_ascii=False)
        f.write("\n")
    os.chmod(tmp, mode)
    os.replace(tmp, path)


def main():
    p = argparse.ArgumentParser(description=__doc__.splitlines()[0])
    p.add_argument("action", choices=["install", "remove", "status"])
    p.add_argument("--hook", required=True, help="absolute path of konvoy-hook")
    p.add_argument("--yes", action="store_true", help="do not ask before writing")
    p.add_argument("files", nargs="+")
    a = p.parse_args()

    seen = []
    for name in a.files:
        path = os.path.realpath(os.path.expanduser(name))
        if path in seen:
            continue
        seen.append(path)
        before = load(path)
        present = ours(before)
        if a.action == "status":
            print(f"{path}: {', '.join(present) if present else 'no Konvoy hooks'}")
            continue
        after = with_ours(before, a.hook) if a.action == "install" else without_ours(before)
        if after == before:
            print(f"{path}: already {'installed' if a.action == 'install' else 'clean'}")
            continue
        print(f"{path}:")
        if a.action == "install":
            for event, matcher in EVENTS:
                print(f"  + {event}{f' ({matcher})' if matcher else ''}: {command(a.hook, event)}")
        else:
            for event in present:
                print(f"  - {event}")
        print("  Other entries in the file stay unchanged.")
        if not a.yes:
            if not sys.stdin.isatty():
                print("  Not a terminal; run again with --yes to write.")
                return 1
            if input("  Write this? [y/N] ").strip().lower() not in ("y", "yes"):
                print("  Nothing written.")
                continue
        save(path, after)
        print("  Written. Claude Code sessions started from now on use it.")
    return 0


if __name__ == "__main__":
    sys.exit(main())
