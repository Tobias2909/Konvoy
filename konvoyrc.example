# Copy to ~/.config/konvoyrc and adjust.
#
# Accounts lists the account keys in the order they appear. Each key needs a
# group [Account <key>]. One account is enough, add as many as you use.
#   Name       shown in the sidebar and the new pane dialog
#   Command    what the pane's shell runs to start Claude Code
#              (a binary, a wrapper script or a shell function)
#   ConfigDir  the account's CLAUDE_CONFIG_DIR, ~/.claude for the default one
#   Color      optional, a palette colour is used when missing

[General]
Accounts=A

[Account A]
Name=claude
Command=claude
ConfigDir=~/.claude

# A second account with its own config folder: add its key to Accounts
# (Accounts=A,B), start its Command once in a terminal to log in, then run
# konvoy --install-hooks again.
#
# [Account B]
# Name=work
# Command=CLAUDE_CONFIG_DIR=~/.claude-work claude
# ConfigDir=~/.claude-work

# Optional: other terminal programs that get a pane, listed under
# Programs and each with a group [Program <key>]. Their keys must differ from
# the accounts'. The new pane dialog shows them in their own row; they need no
# folder or chat. A program shows its state the way Claude Code does, with a
# symbol in front of its terminal title: ◐ or ◑ while it works, ✳ when it is
# done, and ? while it waits for you.
#   Name       shown in the sidebar and the new pane dialog
#   Command    what the pane's shell runs
#   Color      optional, as for accounts
#   Status     optional, a command that prints the program's state as JSON;
#              the program then gets a block in the sidebar with its buttons
#              (see docs/design.md, "Program status")
#   StatusEvery  seconds between two runs of Status, 10 by default
#   Badge      optional, a symbol such as 🌿 that the program's badge shows
#              everywhere in place of its key letter
#
# Programs=F
#
# [Program F]
# Name=Assistant
# Command=my-assistant-chat
# Status=my-assistant-ctl konvoy
# Badge=🌿

[Folders]
# Always listed first in the new pane dialog. The star in the dialog edits this.
Pinned=~/projects/app,~/projects/site

[Usage]
# The usage helper runs while Konvoy does. It sends no requests and only reads
# what Claude Code reports (see docs/design.md, "Usage block").
#   ExtraCommand   optional, prints extra fields per account as JSON
#   ExtraInterval  seconds between two runs of the extra command, 900 by default
