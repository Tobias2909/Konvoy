#!/usr/bin/env python3
"""Konvoy's usage helper: the plan usage of every account in one JSON file.

  konvoy-usage --output FILE --account KEY=CONFIG_DIR [--account ...] [--keep FILE]
               [--extra-command CMD] [--extra-interval 900] [--once]

It sends no requests. Every number comes from Claude Code itself.

Claude Code hands its status line the 5 hour and 7 day limits after each
request. A status line in a Konvoy pane writes them to statusline/<pane>.json
next to the output file (konvoy-statusline does that), as {"config_dir": DIR,
"five_hour": {"percent": P, "resets_at": EPOCH}, "seven_day": {...}}, rewritten
only when they change. Konvoy removes the file when the pane closes, so while
one exists for an account, its numbers are live.

Without such a file the account shows the numbers Claude Code saved last in its
own state file, or the last ones this helper had.

The output file usually sits in the runtime folder, which a reboot empties. With
--keep the helper also writes the same document to a file on disk, but only when
the numbers change, and starts from it when the output file is gone.

The extra command, when given, runs every extra interval and prints JSON in the
form {"accounts": {"<config dir>": {...}}}. Those fields land under "extra" for
that account. Konvoy shows "resets": {"available": N, "expires_at": EPOCH}. The
file keeps when it last ran, so a restart does not run it again early.

The helper ends when the process that started it ends.
"""

import argparse
import json
import os
import shlex
import subprocess
import sys
import tempfile
import time
from datetime import datetime
from pathlib import Path

TICK_S = 5
HEARTBEAT_S = 30
WINDOWS = {"session": "five_hour", "weekly_all": "seven_day"}


def log(message):
    print(f"konvoy-usage: {message}", file=sys.stderr, flush=True)


def read_json(path):
    try:
        return json.loads(Path(path).read_text())
    except (OSError, ValueError):
        return {}


def same_dir(a, b):
    return os.path.normpath(os.path.expanduser(a)) == os.path.normpath(os.path.expanduser(b))


def epoch(value):
    if isinstance(value, (int, float)):
        return value
    try:
        return datetime.fromisoformat(value).timestamp()
    except (TypeError, ValueError):
        return None


def limits_from_cache(data):
    """The 5 hour and 7 day windows of the usage Claude Code saved."""
    out = {}
    for lim in data.get("limits") or []:
        key = WINDOWS.get(lim.get("kind"))
        if key and key not in out:
            out[key] = {"percent": lim.get("percent") or 0, "resets_at": epoch(lim.get("resets_at"))}
    # Older versions keep the windows as top-level objects with a 0-100 utilization.
    for key in WINDOWS.values():
        win = data.get(key)
        if key not in out and isinstance(win, dict) and win.get("utilization") is not None:
            out[key] = {"percent": win["utilization"], "resets_at": epoch(win.get("resets_at"))}
    return out


class Account:
    def __init__(self, key, config_dir):
        self.key = key
        self.dir = Path(os.path.expanduser(config_dir))
        self.limits = None
        self.as_of = None
        self.source = None
        self.live = False
        self.extra = None
        self.state_mtime = None

    def state_file(self):
        # Claude Code keeps its state next to the config dir for the default
        # account and inside it for any other CLAUDE_CONFIG_DIR.
        inside = self.dir / ".claude.json"
        if inside.exists() or self.dir != Path.home() / ".claude":
            return inside
        return Path.home() / ".claude.json"

    def take(self, limits, as_of, source):
        self.limits, self.as_of, self.source = limits, as_of, source

    def read_cache(self):
        """Claude Code's own saved numbers, when they are newer than ours."""
        path = self.state_file()
        try:
            mtime = path.stat().st_mtime
        except OSError:
            return
        if mtime == self.state_mtime:
            return
        self.state_mtime = mtime
        state = read_json(path)
        cached = state.get("cachedUsageUtilization") or {}
        at = (cached.get("fetchedAtMs") or 0) / 1000
        account = (state.get("oauthAccount") or {}).get("accountUuid")
        if cached.get("utilization") and cached.get("accountUuid") == account and at > (self.as_of or 0):
            limits = limits_from_cache(cached["utilization"])
            if limits:
                self.take(limits, at, "cache")

    def take_report(self, report, mtime):
        self.live = True
        limits = {}
        for key in WINDOWS.values():
            win = report.get(key)
            if isinstance(win, dict) and isinstance(win.get("percent"), (int, float)):
                limits[key] = {"percent": win["percent"], "resets_at": epoch(win.get("resets_at"))}
        if limits and mtime > (self.as_of or 0):
            self.take(limits, mtime, "statusline")

    def document(self):
        return {"config_dir": str(self.dir), "live": self.live, "source": self.source, "as_of": self.as_of,
                "limits": self.limits or {}, "extra": self.extra or {}}


def resume(output, keep, accounts):
    """Start from the last file, so a restart shows numbers at once and keeps the
    extra fields until the extra command runs again. Returns when it last ran."""
    doc = read_json(output) or (read_json(keep) if keep else {})
    previous = doc.get("accounts") or {}
    for acc in accounts:
        old = previous.get(acc.key) or {}
        if same_dir(old.get("config_dir") or "", acc.dir):
            acc.limits, acc.as_of, acc.source = old.get("limits") or None, old.get("as_of"), old.get("source")
            acc.extra = old.get("extra") or None
    extra_at = doc.get("extra_at")
    return extra_at if isinstance(extra_at, (int, float)) else None


def read_reports(folder, accounts):
    for acc in accounts:
        acc.live = False
    try:
        files = list(Path(folder).glob("*.json"))
    except OSError:
        return
    for path in files:
        try:
            mtime = path.stat().st_mtime
            report = json.loads(path.read_text())
        except (OSError, ValueError):
            continue
        for acc in accounts:
            if isinstance(report, dict) and same_dir(report.get("config_dir") or "", acc.dir):
                acc.take_report(report, mtime)


def run_extra(command, accounts):
    argv = [os.path.expanduser(a) for a in shlex.split(command)]
    try:
        p = subprocess.run(argv, stdin=subprocess.DEVNULL, capture_output=True, text=True, timeout=120)
        if p.returncode:
            return log(f"extra command exit {p.returncode}: {p.stderr.strip()[-200:]}")
        data = json.loads(p.stdout)
    except (OSError, subprocess.TimeoutExpired, ValueError) as err:
        return log(f"extra command failed: {err}")
    for config_dir, fields in (data.get("accounts") or {}).items():
        for acc in accounts:
            if same_dir(config_dir, acc.dir) and isinstance(fields, dict):
                acc.extra = fields


def write(path, doc):
    path.parent.mkdir(parents=True, exist_ok=True)
    fd, tmp = tempfile.mkstemp(dir=path.parent, prefix=".usage.")
    with os.fdopen(fd, "w") as f:
        json.dump(doc, f, indent=1)
        f.write("\n")
    os.replace(tmp, path)


def main():
    ap = argparse.ArgumentParser(description="Collect the plan usage Claude Code reports into one JSON file.")
    ap.add_argument("--output", required=True)
    ap.add_argument("--account", action="append", default=[], metavar="KEY=CONFIG_DIR")
    ap.add_argument("--keep", default="", help="a copy on disk that outlives a reboot")
    ap.add_argument("--extra-command", default="")
    ap.add_argument("--extra-interval", type=int, default=900)
    ap.add_argument("--once", action="store_true", help="collect once, write and exit")
    args = ap.parse_args()

    accounts = []
    for spec in args.account:
        key, sep, config_dir = spec.partition("=")
        if not sep or not key or not config_dir:
            ap.error(f"--account expects KEY=CONFIG_DIR, got {spec!r}")
        accounts.append(Account(key, config_dir))
    output = Path(args.output)
    keep = Path(os.path.expanduser(args.keep)) if args.keep else None
    reports = output.parent / "statusline"
    extra_at = resume(output, keep, accounts)
    extra_interval = max(args.extra_interval, 60)
    parent = os.getppid()
    next_extra = extra_at + extra_interval if extra_at else time.time()
    written, written_at = None, 0

    while True:
        now = time.time()
        read_reports(reports, accounts)
        for acc in accounts:
            acc.read_cache()
        if args.extra_command and now >= next_extra:
            run_extra(args.extra_command, accounts)
            extra_at, next_extra = now, now + extra_interval
        body = {acc.key: acc.document() for acc in accounts}
        # Written at least every HEARTBEAT_S, so a reader can tell the helper runs.
        if (body, extra_at) != written or now - written_at >= HEARTBEAT_S:
            doc = {"version": 2, "written": time.time(), "extra_at": extra_at, "accounts": body}
            write(output, doc)
            # The disk copy skips the heartbeat.
            if keep and (body, extra_at) != written:
                try:
                    write(keep, doc)
                except OSError as err:
                    log(f"cannot keep the numbers in {keep}: {err}")
            written, written_at = (body, extra_at), now
        if args.once or os.getppid() != parent:
            return 0
        time.sleep(TICK_S)


if __name__ == "__main__":
    sys.exit(main())
